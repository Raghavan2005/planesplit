# Comma-separated list of origins allowed to open the /ws WebSocket and to
# make CORS requests. Defaults to http://localhost:5173,http://127.0.0.1:5173
# (Vite's default dev port) if unset -- see main.py's ALLOWED_ORIGINS.
# Override this if the frontend is served from a different host/port (a LAN
# IP for a projector, a non-default Vite port, a `vite preview` build).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
